# DVD 리포 루트(여기에 docker-compose-lite.yaml 존재)
DVD_ROOT="$HOME/MTD/MTD_full_testbed/Damn-Vulnerable-Drone"
STACK_FILE="docker-compose-lite.yaml"

# DVD-lite 서비스명(컴포즈 기준)
SVC_FC="flight-controller-lite"
SVC_COMP="companion-computer-lite"
SVC_GCS="ground-control-station-lite"
SVC_SIM="simulator-lite"

# 관심 포트(네트워크 수집용)
PORTS='udp port 14540 or udp port 14550 or udp port 14551 or tcp port 8000 or tcp port 8080 or tcp port 3000 or tcp port 5760 or tcp port 9003 or udp port 5760'

# 출력 베이스(실험마다 run_id로 하위에 저장)
OUT_BASE="$HOME/MTD/MTD_full_testbed/outputs/obs"

# NS-3 루트(기본값: 너가 알려준 경로)
NS3_ROOT="$HOME/MTD/MTD_full_testbed/ns-3.45/ns-3-dev"
