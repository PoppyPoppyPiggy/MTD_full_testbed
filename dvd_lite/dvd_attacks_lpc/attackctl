#!/usr/bin/env bash
set -euo pipefail
__DIR__="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
. "$__DIR__/00_env.sh"

YAML="${1:-"$__DIR__/scenarios/sample_lpc.yaml"}"
jq_check(){ command -v jq >/dev/null 2>&1 || { echo "[ERR] jq required"; exit 1; }; }
yq_check(){ command -v yq >/dev/null 2>&1 || { echo "[ERR] yq required"; exit 1; }; }
jq_check; yq_check

export LPC_PROFILE="$__DIR__/scenarios/options.d/profile_stealth.env"
export LPC_PHASE_FILE="$(yq -r '.phases_csv' "$YAML")"
export LPC_MAX_BUDGET="$(yq -r '.budget' "$YAML")"
export LPC_INTERVAL_MS="$(yq -r '.interval_ms' "$YAML")"
export LPC_JITTER_PCT="$(yq -r '.jitter_pct' "$YAML")"
export LPC_BACKOFF="$(yq -r '.backoff' "$YAML")"
export LPC_ROTATE_TARGETS="$(yq -r '.rotate' "$YAML")"
export LPC_WINDOW="$(yq -r '.window' "$YAML")"

# targets.txt 생성
: > "$__DIR__/scenarios/targets.txt"
yq -r '.targets[]' "$YAML" >> "$__DIR__/scenarios/targets.txt"

# 각 action 모듈 실행 (병렬/순차 선택 가능: 여기선 순차 백그라운드)
mapfile -t MODS < <(yq -r '.actions[].module' "$YAML")
i=0
for m in "${MODS[@]}"; do
  envfile="$__DIR__/scenarios/.env_action_$i"
  : > "$envfile"
  yq -r ".actions[$i].env | to_entries[] | \"export \"+.key+\"=\"+.value" "$YAML" >> "$envfile" || true
  ( set -a; source "$envfile"; set +a; bash -lc "$m" ) &
  echo "[attackctl] started $m (pid=$!)"
  i=$((i+1))
done

wait
echo "[attackctl] all modules finished"
