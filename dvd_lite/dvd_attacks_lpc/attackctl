#!/usr/bin/env bash
# attackctl — YAML 시나리오 실행기 (yq만 요구)
set -euo pipefail
__DIR__="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
. "$__DIR__/00_env.sh"

YAML="${1:-"$__DIR__/scenarios/sample_lpc.yaml"}"

# --- deps ---
if ! command -v yq >/dev/null 2>&1; then
  echo "[ERR] yq not found. Install: sudo apt-get install -y yq" >&2
  exit 1
fi

# --- read YAML with defaults ---
get(){ yq -r "$1 // \"$2\"" "$YAML"; }

export LPC_PHASE_FILE="$(get '.phases_csv' "$__DIR__/scenarios/options.d/mission_phases.csv")"
export LPC_MAX_BUDGET="$(get '.budget' 120)"
export LPC_INTERVAL_MS="$(get '.interval_ms' 15000)"
export LPC_JITTER_PCT="$(get '.jitter_pct' 30)"
export LPC_BACKOFF="$(get '.backoff' "exp")"
export LPC_ROTATE_TARGETS="$(get '.rotate' "roundrobin")"
# ※ window가 비어있지 않으면 그 값, 비어있으면 “빈 문자열(=제한 없음)”
_w="$(yq -r '.window // ""' "$YAML")"; export LPC_WINDOW="${_w:-}"

# targets.txt 생성
: > "$__DIR__/scenarios/targets.txt"
yq -r '.targets[]?' "$YAML" >> "$__DIR__/scenarios/targets.txt" || true

# actions 배열 파싱
mapfile -t MODS < <(yq -r '.actions[].module' "$YAML")
_total="${#MODS[@]}"
if [[ "$_total" -eq 0 ]]; then
  echo "[attackctl] no actions in $YAML"; exit 1
fi

i=0
for m in "${MODS[@]}"; do
  envfile="$__DIR__/scenarios/.env_action_$i"
  : > "$envfile"
  # env 항목이 없을 수도 있으니 optional 파싱
  yq -r ".actions[$i].env | to_entries? // [] | \"export \"+.key+\"=\"+.value" "$YAML" >> "$envfile" || true
  ( set -a; source "$envfile"; set +a; bash -lc "$m" ) &
  echo "[attackctl] started $m (pid=$!)"
  i=$((i+1))
done

wait
echo "[attackctl] all modules finished"
