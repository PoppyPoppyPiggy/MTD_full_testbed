#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "$0")/../.." && pwd)/00_env_ext.sh"

log_bus() { printf '[%s] BUS ATK %s\n' "$(date +%s)" "$*" | tee -a "$BUS_LOG" >/dev/null; }

_run_py() {
  local key="$1" level="$2"
  python3 "$DVD_BASE/modules/attacks/lpc_runner.py" "$key" "$level"
}

run_attack() {
  local key="${1:?}"; local level="${2:-low}"
  log_bus "ATTACK_START key=${key} level=${level}"
  _run_py "$key" "$level"
  log_bus "ATTACK_END key=${key} level=${level}"
}
