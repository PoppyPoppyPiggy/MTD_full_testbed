    "rtsp_udp_trickle": {
      "engine": "udp_trickle",
      "mitre": { "tactic": "Impact", "tactic_id": "TA0040", "technique": "Service Degradation (RTP/RTSP)", "technique_id": "T1499" },
      "levels": {
        "low":  { "pps": 50,  "duration_s": 15, "payload": 200 },
        "mid":  { "pps": 200, "duration_s": 20, "payload": 300 },
        "high": { "pps": 600, "duration_s": 25, "payload": 400 }
