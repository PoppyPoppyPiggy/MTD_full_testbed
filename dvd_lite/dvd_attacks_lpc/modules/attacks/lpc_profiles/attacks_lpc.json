{
  "version": "1.1",
  "defaults": {
    "mavlink_host_env": "MAVLINK_HOST",
    "mavlink_port_env": "MAVLINK_PORT",
    "rtsp_host_env": "RTSP_HOST",
    "rtsp_port_env": "RTSP_PORT",
    "http_cam_host_env": "HTTP_CAM_HOST",
    "http_cam_port_env": "HTTP_CAM_PORT"
  },
  "attacks": {
    "mavlink_param_poll": {
      "engine": "mavlink_param_poll",
      "mitre": { "tactic": "Discovery", "tactic_id": "TA0007", "technique": "Query Device Parameters", "technique_id": "T1046" },
      "levels": {
        "low":  { "count": 12, "interval_s": 1.0, "names": ["SYSID_THISMAV","STAT_RUNTIME","ARMING_CHECK","ATC_ANG_RLL_P"] },
        "mid":  { "count": 24, "interval_s": 0.6, "names": ["SYSID_THISMAV","STAT_RUNTIME","ARMING_CHECK","ATC_ANG_RLL_P","ATC_ANG_PIT_P","LOIT_SPEED"] },
        "high": { "count": 48, "interval_s": 0.35, "names": ["*"] }
      }
    },
    "mavlink_statustext_noise": {
      "engine": "mavlink_inject",
      "message": "STATUSTEXT",
      "severity": 5,
      "mitre": { "tactic": "Protocol Tampering", "tactic_id": "TA0005", "technique": "MAVLink Message Injection", "technique_id": "T1565" },
      "levels": {
        "low":  { "pps": 5,  "burst_ms": 1500, "sleep_ms": 500,  "text": "dbg:keepalive" },
        "mid":  { "pps": 10, "burst_ms": 1800, "sleep_ms": 400,  "text": "dbg:status" },
        "high": { "pps": 20, "burst_ms": 2000, "sleep_ms": 300,  "text": "dbg:noise" }
      }
    },
    "mavlink_cmdlong_tease": {
      "engine": "mavlink_inject",
      "message": "COMMAND_LONG",
      "command": 511,
      "params": [0,0,0,0,0,0,0],
      "mitre": { "tactic": "Protocol Tampering", "tactic_id": "TA0005", "technique": "MAVLink Command Teasing", "technique_id": "T1565" },
      "levels": {
        "low":  { "pps": 2,  "burst_ms": 1200, "sleep_ms": 800 },
        "mid":  { "pps": 5,  "burst_ms": 1600, "sleep_ms": 600 },
        "high": { "pps": 10, "burst_ms": 2000, "sleep_ms": 400 }
      }
    },
    "mavlink_mission_trickle": {
      "engine": "mavlink_mission_trickle",
      "mitre": { "tactic": "Injection", "tactic_id": "TA0003", "technique": "Waypoint Injection", "technique_id": "T1059" },
      "levels": {
        "low":  { "items": 2, "interval_s": 1.5, "offset_m": 2 },
        "mid":  { "items": 4, "interval_s": 1.0, "offset_m": 5 },
        "high": { "items": 8, "interval_s": 0.7, "offset_m": 8 }
      }
    },
    "gps_slow_spoof": {
      "engine": "mavlink_inject",
      "message": "GPS_INPUT",
      "mitre": { "tactic": "Protocol Tampering", "tactic_id": "TA0005", "technique": "GPS Spoofing-lite", "technique_id": "T1592" },
      "levels": {
        "low":  { "pps": 3,  "burst_ms": 1200, "sleep_ms": 800,  "delta_m": 2  },
        "mid":  { "pps": 6,  "burst_ms": 1500, "sleep_ms": 600,  "delta_m": 6  },
        "high": { "pps": 10, "burst_ms": 2000, "sleep_ms": 400,  "delta_m": 12 }
      }
    },
    "rtsp_slowpull": {
      "engine": "rtsp_slowpull",
      "mitre": { "tactic": "Discovery", "tactic_id": "TA0007", "technique": "Camera Stream Enumeration", "technique_id": "T1046" },
      "levels": {
