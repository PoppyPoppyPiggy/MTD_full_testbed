{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "bus_dvd.log JSONL schema",
    "type": "object",
    "required": ["ts", "evt"],
    "properties": {
      "ts": { "type": "string", "description": "ISO8601 UTC" },
      "t":  { "type": "number", "description": "epoch seconds (optional)" },
      "container": { "type": "string" },
      "evt": { "type": "string",
        "enum": ["docker_event","stats","env_change","proc_change","net_change","probe"] },
      "data": {},
      "diff": { "type": "string" },
      "stats": { "type": "object",
        "properties": {
          "CPUPerc": { "type": "string" },
          "MemUsage": { "type": "string" },
          "NetIO":   { "type": "string" }
        }
      }
    }
  }
  