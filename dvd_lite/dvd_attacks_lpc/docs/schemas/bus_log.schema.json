{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "bus.log JSONL schema",
    "type": "object",
    "required": ["ts", "evt", "src"],
    "properties": {
      "ts": { "type": "string", "description": "ISO8601 UTC (e.g., 2025-09-04T00:12:34Z)" },
      "t":  { "type": "number", "description": "epoch seconds (optional)" },
      "src": { "type": "string", "enum": ["attack","mtd","probe","system"] },
      "scenario_id": { "type": "string" },
      "step_id": { "type": "string" },
      "group_id": { "type": "string", "description": "concurrency group id (optional)" },
  
      "evt":  { "type": "string",
        "enum": ["attack_start","attack_end","mtd_action","probe","note"] },
  
      "mitre": {
        "type": "object",
        "properties": {
          "tactic":    { "type": "string" },       "technique": { "type": "string" },
          "tactic_id": { "type": "string" },       "technique_id": { "type": "string" }
        }
      },
  
      "attack": {
        "type": "object",
        "properties": {
          "module": { "type": "string" },          "level": { "type": "string" },
          "params": { "type": "object" },          "duration_s": { "type": "number" }
        }
      },
  
      "mtd": {
        "type": "object",
        "properties": {
          "action": { "type": "string" },
          "params": { "type": "object" }
        }
      },
  
      "impair": {
        "type": "object",
        "description": "네트워크 영향(추정값) — 타임라인 구성에 직접 사용",
        "properties": {
          "loss_pct": { "type": "number" }, "delay_ms": { "type": "number" },
          "jitter_ms": { "type": "number" }, "dup_pct": { "type": "number" },
          "rate_limit_mbps": { "type": "number" },
          "t_apply_s": { "type": "number", "description": "효과 시작 시각(epoch) (없으면 ts 사용)" },
          "t_duration_s": { "type": "number", "description": "효과 지속 시간(초)" }
        }
      }
    }
  }
  