#!/usr/bin/env bash
# lpc_state.shlib - 강화된 LPC 상태머신

# 상태 상수
declare -r LPC_STATE_IDLE="idle"
declare -r LPC_STATE_RECON="recon"
declare -r LPC_STATE_PROBE="probe"
declare -r LPC_STATE_NIBBLE="nibble"
declare -r LPC_STATE_HOLD="hold"
declare -r LPC_STATE_ESCALATE="escalate"
declare -r LPC_STATE_RETREAT="retreat"

# 기본 파라미터
: "${LPC_DUTY:=0.08}"
: "${LPC_INTERVAL_MS:=15000}"
: "${LPC_JITTER_PCT:=30}"
: "${LPC_BACKOFF:=exp}"
: "${LPC_MAX_BUDGET:=120}"
: "${LPC_WINDOW_START:=}"
: "${LPC_WINDOW_END:=}"
: "${LPC_THROTTLE_ON_ALERT:=true}"
: "${LPC_NOISE_RATIO:=0.2}"
: "${LPC_PERSISTENCE_HOURS:=24}"
LPC_CONTEXT_FILE="${LPC_LOG_DIR:-/tmp}/lpc_context_${ATTACK_NAME:-default}.state"

# 컨텍스트 관리
_lpc_is_context_expired() {
  [[ ! -f "$LPC_CONTEXT_FILE" ]] && return 0
  local s=$(grep "^session_start=" "$LPC_CONTEXT_FILE" | cut -d= -f2)
  local now=$(date +%s)
  local elapsed=$((now - s))
  local max=$((LPC_PERSISTENCE_HOURS*3600))
  [[ $elapsed -gt $max ]]
}
_lpc_init_context() {
  local now=$(date +%s)
  if [[ ! -f "$LPC_CONTEXT_FILE" ]] || _lpc_is_context_expired; then
    cat >"$LPC_CONTEXT_FILE"<<EOF
current_state=$LPC_STATE_IDLE
budget_used=0
success_count=0
failure_count=0
detection_count=0
last_action_time=0
current_interval=$LPC_INTERVAL_MS
backoff_multiplier=1.0
target_index=0
session_start=$now
alert_level=0
EOF
  fi
}
_lpc_load_context(){ _lpc_init_context; source "$LPC_CONTEXT_FILE"; }
_lpc_save_context(){
  cat >"$LPC_CONTEXT_FILE"<<EOF
current_state=$current_state
budget_used=$budget_used
success_count=$success_count
failure_count=$failure_count
detection_count=$detection_count
last_action_time=$last_action_time
current_interval=$current_interval
backoff_multiplier=$backoff_multiplier
target_index=$target_index
session_start=$session_start
alert_level=$alert_level
EOF
}

# 시간창
_lpc_is_within_window(){
  [[ -z "$LPC_WINDOW_START" || -z "$LPC_WINDOW_END" ]] && return 0
  local now=$(date +%H:%M) s="$LPC_WINDOW_START" e="$LPC_WINDOW_END"
  if [[ "$s" < "$e" ]]; then [[ "$now" > "$s" && "$now" < "$e" ]]; else [[ "$now" > "$s" || "$now" < "$e" ]]; fi
}

# 예산/지터/백오프
_lpc_check_budget(){ _lpc_load_context; [[ $budget_used -lt $LPC_MAX_BUDGET ]]; }
_lpc_jitter_ms(){
  _lpc_load_context
  local base=$current_interval
  local rng=$(( base * LPC_JITTER_PCT / 100 ))
  local j=$(( RANDOM % (rng*2+1) - rng ))
  local res=$(( base + j )); (( res < 1000 )) && res=1000; echo "$res"
}
_lpc_apply_backoff(){
  local success="$1"; _lpc_load_context
  if [[ "$success" == "true" ]]; then
    backoff_multiplier="1.0"; current_interval=$LPC_INTERVAL_MS
  else
    case "$LPC_BACKOFF" in
      linear) backoff_multiplier=$(awk "BEGIN{print $backoff_multiplier+0.5}") ;;
      exp)    backoff_multiplier=$(awk "BEGIN{print $backoff_multiplier*2.0}") ;;
      *)      ;;
    esac
    backoff_multiplier=$(awk "BEGIN{print ($backoff_multiplier>10)?10:$backoff_multiplier}")
    current_interval=$(awk "BEGIN{print int($LPC_INTERVAL_MS*$backoff_multiplier)}")
  fi
  _lpc_save_context
}
_lpc_should_throttle(){ _lpc_load_context; [[ "$LPC_THROTTLE_ON_ALERT" == "true" && $alert_level -ge 2 ]]; }

# 전이 함수
_lpc_transition_idle(){
  _lpc_load_context
  ! _lpc_is_within_window && echo "$LPC_STATE_IDLE" && return
  ! _lpc_check_budget && echo "$LPC_STATE_RETREAT" && return
  local now=$(date +%s) max=$((LPC_PERSISTENCE_HOURS*3600))
  local elapsed=$((now - session_start)); (( elapsed > max )) && echo "$LPC_STATE_RETREAT" && return
  echo "$LPC_STATE_RECON"
}
_lpc_transition_recon(){ _lpc_load_context; (( detection_count>0 )) && echo "$LPC_STATE_RETREAT" || echo "$LPC_STATE_PROBE"; }
_lpc_transition_probe(){
  _lpc_load_context
  (( detection_count>2 )) && echo "$LPC_STATE_RETREAT" && return
  (( success_count>0 )) && echo "$LPC_STATE_NIBBLE" && return
  (( failure_count>3 )) && echo "$LPC_STATE_HOLD" && return
  echo "$LPC_STATE_PROBE"
}
_lpc_transition_nibble(){
  _lpc_load_context
  _lpc_should_throttle && echo "$LPC_STATE_HOLD" && return
  (( success_count>5 )) && echo "$LPC_STATE_ESCALATE" && return
  (( detection_count>1 )) && echo "$LPC_STATE_RETREAT" && return
  echo "$LPC_STATE_NIBBLE"
}
_lpc_transition_hold(){ _lpc_load_context; (( alert_level<2 )) && echo "$LPC_STATE_PROBE" || echo "$LPC_STATE_HOLD"; }
_lpc_transition_escalate(){ _lpc_load_context; (( detection_count>0 )) && echo "$LPC_STATE_RETREAT" || echo "$LPC_STATE_ESCALATE"; }
_lpc_transition_retreat(){ echo "$LPC_STATE_IDLE"; }

# 전이 실행
_lpc_transition(){
  local mtd_event="${1:-}" detection_signal="${2:-}"
  _lpc_load_context
  local old="$current_state"
  [[ -n "$mtd_event" ]] && _log_bus "mtd_event_detected" "event=$mtd_event" && ((alert_level=alert_level<3?alert_level+1:3))
  [[ -n "$detection_signal" ]] && _log_bus "detection_signal" "signal=$detection_signal" && ((detection_count++)) && alert_level=3
  case "$current_state" in
    "$LPC_STATE_IDLE")     current_state=$(_lpc_transition_idle) ;;
    "$LPC_STATE_RECON")    current_state=$(_lpc_transition_recon) ;;
    "$LPC_STATE_PROBE")    current_state=$(_lpc_transition_probe) ;;
    "$LPC_STATE_NIBBLE")   current_state=$(_lpc_transition_nibble) ;;
    "$LPC_STATE_HOLD")     current_state=$(_lpc_transition_hold) ;;
    "$LPC_STATE_ESCALATE") current_state=$(_lpc_transition_escalate) ;;
    "$LPC_STATE_RETREAT")  current_state=$(_lpc_transition_retreat) ;;
  esac
  if [[ "$current_state" != "$old" ]]; then
    _log_bus "state_transition" "from_state=$old" "to_state=$current_state" "budget_used=$budget_used" "alert_level=$alert_level"
  fi
  _lpc_save_context
  echo "$current_state"
}

# 실행/기록
_lpc_should_act(){
  _lpc_load_context
  ! _lpc_is_within_window && return 1
  ! _lpc_check_budget && return 1
  case "$current_state" in "$LPC_STATE_PROBE"|"$LPC_STATE_NIBBLE"|"$LPC_STATE_ESCALATE") ;; *) return 1 ;; esac
  local duty="$LPC_DUTY"
  awk "BEGIN{exit !(rand()< $duty)}" || return 1
  if _lpc_should_throttle; then
    local d; d=$(awk "BEGIN{print $duty/2}"); awk "BEGIN{exit !(rand()< $d)}" || return 1
  fi
  return 0
}
_lpc_record_action_result(){
  local success="$1"; _lpc_load_context
  ((budget_used++)); last_action_time=$(date +%s)
  [[ "$success" == "true" ]] && ((success_count++)) || ((failure_count++))
  _lpc_apply_backoff "$success"
  _log_bus "action_result" "success=$success" "budget_used=$budget_used" "backoff_multiplier=$backoff_multiplier"
}

run_lpc_loop_with_state(){
  local action_func="$1" duration="${2:-0}"
  local start=$(date +%s) end=
  [[ "$duration" -gt 0 ]] && end=$((start+duration))
  _lpc_init_context
  while true; do
    local st=$(_lpc_transition)
    [[ -n "${end:-}" && $(date +%s) -ge "$end" ]] && break
    [[ "$st" == "$LPC_STATE_RETREAT" ]] && break
    if _lpc_should_act; then
      _log_bus "executing_action" "state=$st"
      if $action_func; then _lpc_record_action_result "true"; else _lpc_record_action_result "false"; fi
    fi
    local ms=$(_lpc_jitter_ms); _log_bus "waiting" "interval_sec=$(awk "BEGIN{printf(\"%.3f\", $ms/1000)}")" "state=$st"
    sleep "$(awk "BEGIN{printf(\"%.3f\", $ms/1000)}")"
  done
  _log_bus "lpc_loop_completed" "final_state=$(_lpc_transition)"
}

# 도우미
_lpc_show_context(){ _lpc_load_context; cat <<E; }
=== LPC Context ===
state: $current_state
budget: $budget_used / $LPC_MAX_BUDGET
success/failure: $success_count / $failure_count
detections: $detection_count
alert_level: $alert_level
backoff_multiplier: $backoff_multiplier
current_interval(ms): $current_interval
session_start: $(date -d @$session_start)
===================
E
_lpc_reset_context(){ [[ -f "$LPC_CONTEXT_FILE" ]] && rm -f "$LPC_CONTEXT_FILE"; _lpc_init_context; _log_bus "context_reset" "attack_name=${ATTACK_NAME:-unknown}"; }

# 직접 실행 시 유틸
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  case "${1:-}" in
    show|status) _lpc_show_context ;;
    reset) _lpc_reset_context ;;
    *) echo "Usage: $0 {show|reset}" ;;
  esac
fi
