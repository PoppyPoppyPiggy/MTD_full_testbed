# attack_std.shlib - 공통 로깅/루프 유틸
# 사용 전 00_env.sh 로드 필요 (BUS_LOG 보장)

_log_bus() {
  local name="$1"; shift
  local line="[$(date '+%F %T')] [$name] $*"
  # 콘솔 + 파일 동시 기록
  echo "$line" | tee -a "${BUS_LOG:-${LPC_LOG_DIR:-.}/bus.log}" >/dev/null
}

# === (선택) 강화 상태머신 사용 래퍼 ===
run_lpc_loop() {
  local action_func="$1"
  local duration="${2:-0}"

  if [[ "${LPC_USE_STATE_MACHINE:-true}" == "true" ]]; then
    local lpc_state_lib="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/lpc_state.shlib"
    [[ -f "$lpc_state_lib" ]] && source "$lpc_state_lib"
    if declare -f run_lpc_loop_with_state >/dev/null; then
      run_lpc_loop_with_state "$action_func" "$duration"
      return
    fi
  fi

  # 폴백(간단 루프)
  local start_time end_time
  start_time=$(date +%s)
  [[ "$duration" -gt 0 ]] && end_time=$((start_time + duration))

  while true; do
    [[ -n "${end_time:-}" && $(date +%s) -ge "$end_time" ]] && break
    local duty="${LPC_DUTY:-0.1}"
    local interval_ms="${LPC_INTERVAL_MS:-15000}"
    awk "BEGIN {exit !(rand() < $duty)}" && $action_func
    sleep "$(awk "BEGIN {printf(\"%.3f\", $interval_ms/1000)}")"
  done
}
