#!/usr/bin/env bash
# attack_std.shlib - 공통 로깅/루프 유틸 (수정판)
# 사용 전 00_env.sh 로드 필요 (BUS_LOG 보장)

# 올바른 함수명으로 수정
_log_bus() {
  local name="$1"; shift
  local line="[$(date '+%F %T')] [$name] $*"
  # 콘솔 + 파일 동시 기록
  echo "$line" | tee -a "${BUS_LOG:-${LPC_LOG_DIR:-.}/bus.log}" >/dev/null
}

# 하위 호환성을 위한 alias (기존 _log_bus 호출 지원)
log_bus() { _log_bus "$@"; }

# 교체/추가 (핵심 부분만)
run_lpc_loop() {
  local action_func="$1"
  local duration_raw="${2:-0}"
  # "20s" 같은 입력을 정수초로 정규화
  local duration="$(echo "$duration_raw" | sed -E 's/[^0-9]//g')"
  duration="${duration:-0}"

  if [[ "$duration" -le 0 ]]; then
    echo "[DEBUG] Duration이 0 이하, 루프 스킵"
    return 0
  fi

  local interval_ms="${LPC_INTERVAL_MS:-1000}"   # 기본 1초
  local start_time end_time current_time
  start_time=$(date +%s)
  end_time=$((start_time + duration))

  echo "[DEBUG] LPC 루프 시작: ${duration}s, interval=${interval_ms}ms"
  while true; do
    current_time=$(date +%s)
    (( current_time >= end_time )) && break

    if command -v "$action_func" >/dev/null 2>&1; then
      "$action_func"
    else
      echo "[ERROR] 액션 함수 '$action_func' 찾을 수 없음"
      break
    fi

    # 인터벌 대기
    python3 - <<PY "$interval_ms"
import sys,time
ms=int(sys.argv[1]) if sys.argv[1].isdigit() else 1000
time.sleep(ms/1000.0)
PY
  done
  _log_bus "lpc_loop_completed" "duration=${duration}s"
  echo "[DEBUG] LPC 루프 완료"
}

# 디버그용 함수
debug_log() {
  echo "[DEBUG] $*" >&2
}