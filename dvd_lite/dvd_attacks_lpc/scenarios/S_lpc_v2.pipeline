# 프로필/페이즈 프롤로그 (있으면 적용)
source scenarios/options.d/profile_stealth.env ; export LPC_PHASE_FILE=scenarios/options.d/mission_phases.csv

# --- 항법/링크/융합/운용 저강도 믹스 (예산은 각 줄에서 오버라이드) ---

# 항법: WP 미세 편향 (총 6회, 짧은 주기)
LPC_MAX_BUDGET=6  LPC_INTERVAL_MS=800  LPC_STEP=0.8   ./modules/waypoint_drift.sh

# 링크: 저율 지터/손실 (기존 telemetry_* 모듈 재사용 예)
LPC_MAX_BUDGET=6  LPC_INTERVAL_MS=1000 LPC_STEP=0.02  ./modules/telemetry_trickle_jam.sh

# 융합: 잔차 소폭 증가
LPC_MAX_BUDGET=6  LPC_INTERVAL_MS=1200 LPC_STEP=0.015 ./modules/sensor_fusion_noise.sh

# 운용: RTH 여유도 미세 축소
LPC_MAX_BUDGET=4  LPC_INTERVAL_MS=1500 LPC_STEP=0.010 ./modules/safe_rth_penalty.sh

# (옵션) 기존 gps_slow_spoof를 매우 약하게 섞고 싶으면 아래처럼 단계적으로:
# LPC_MAX_BUDGET=3  LPC_INTERVAL_MS=2000 LPC_STEP=0.5  ./modules/gps_slow_spoof.sh
