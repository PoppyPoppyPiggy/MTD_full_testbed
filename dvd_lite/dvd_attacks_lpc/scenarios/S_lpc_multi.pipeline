#!/usr/bin/env bash
set -euo pipefail
echo "=== LPC 다중 공격 시나리오 시작 ==="
BASE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/.."
cd "$BASE_DIR"
source 00_env.sh
source "$(dirname "$0")/options.d/profile_stealth.env"

ATTACK_DURATION=60
OVERLAP_DELAY=15

echo "1단계: 초기 정찰"
DUR=$ATTACK_DURATION INTENSITY=low modules/wifi_slow_scan.sh & PID_WIFI=$!

sleep $OVERLAP_DELAY
echo "2단계: 텔레메트리 간섭"
DUR=$ATTACK_DURATION INTENSITY=low modules/telemetry_trickle_jam.sh & PID_TELEM=$!

sleep $OVERLAP_DELAY
echo "3단계: 파라미터 드리프트"
DUR=$ATTACK_DURATION INTENSITY=medium modules/mavlink_param_drift.sh & PID_PARAM=$!

sleep $OVERLAP_DELAY
echo "4단계: GPS 교란"
DUR=$ATTACK_DURATION INTENSITY=medium modules/gps_slow_spoof.sh & PID_GPS=$!

wait $PID_WIFI $PID_TELEM $PID_PARAM $PID_GPS
echo "=== LPC 다중 공격 시나리오 완료 ==="

echo "자동 평가..."
tools/auto_eval.sh
